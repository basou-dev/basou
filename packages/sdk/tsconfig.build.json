{
  // Emits the declaration files; tsup emits the JavaScript. Declarations are
  // not left to tsup because its declaration build needs the TypeScript
  // compiler API, which TypeScript 7 no longer provides. `files` names the
  // entry alone, so the modules declared are the ones reachable from it, and a
  // module only the tests reach is left out.
  //
  // They go to `temp/dts`, one file per module, not to `dist`: API Extractor
  // (`api-extractor.json`) rolls them into the one `dist/index.d.ts` the
  // package ships. The one file holds what the entry exports and what that
  // refers to, so an export a module keeps for its tests stays out of it, and
  // a documentation link to any of it resolves. The same run writes the API
  // report, `etc/sdk.api.md`, which CI compares with the committed one.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationDir": "./temp/dts",
    "declarationMap": false,
    "incremental": false
  },
  "include": [],
  "files": ["src/index.ts"]
}
